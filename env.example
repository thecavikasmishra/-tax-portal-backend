# Database
DATABASE_URL=postgresql://user:password@localhost:5432/tax_portal

# Google Drive
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
DRIVE_ROOT_FOLDER_ID=your_google_drive_folder_id

# Auth
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
ADMIN_EMAIL=ca@yourdomain.com
ADMIN_PASSWORD_HASH=run_node_scripts/hashPassword.js_to_generate

# Email (using Gmail)
EMAIL_USER=yourmail@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM="Your CA Firm <yourmail@gmail.com>"

# App
PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
